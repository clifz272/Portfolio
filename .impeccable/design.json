  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Filled résumé/contact action; inherited CSS variables bind both shipped themes.",
      "html": "<a class=\"ds-primary\" href=\"#resume\">Download my resume <svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2\"/><path d=\"M7 11l5 5 5-5M12 4v12\"/></svg></a>",
      "css": ".ds-primary{font-family:Manrope,Arial,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:23px;min-height:50px;padding:13px 23px;font-size:14px;line-height:1.5;font-weight:600;border-radius:999px;white-space:nowrap;text-decoration:none;background:var(--accent,#a9befa);color:var(--accent-text,#101b36);transition:background var(--duration,.25s),transform var(--duration,.25s) var(--ease,cubic-bezier(.16,1,.3,1))}.ds-primary:hover{background:var(--accent-hover,#c5d2ff);transform:translateY(-2px)}.ds-primary:active{transform:scale(.98)}.ds-primary:focus-visible,.ds-link:focus-visible,.ds-toggle:focus-visible,.ds-nav a:focus-visible,.ds-summary:focus-visible,.ds-motion:focus-visible{outline:2px solid var(--accent,#a9befa);outline-offset:5px}@media(max-width:767px){.ds-primary{font-size:13px;gap:17px;padding-inline:20px}}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Text action",
      "kind": "button",
      "refersTo": "text-link",
      "description": "Accent link with an underline on hover and a generous minimum target height.",
      "html": "<a class=\"ds-link\" href=\"#projects\">Explore my projects <svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M17 7 7 17M8 7h9v9\"/></svg></a>",
      "css": ".ds-link{font-family:Manrope,Arial,sans-serif;display:inline-flex;align-items:center;gap:10px;min-height:44px;padding:6px 0;font-size:14px;line-height:1.5;color:var(--accent,#a9befa);text-decoration:underline;text-decoration-color:transparent;text-underline-offset:6px;transition:text-decoration-color .2s}.ds-link:hover{text-decoration-color:currentColor}.ds-primary:focus-visible,.ds-link:focus-visible,.ds-toggle:focus-visible,.ds-nav a:focus-visible,.ds-summary:focus-visible,.ds-motion:focus-visible{outline:2px solid var(--accent,#a9befa);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-link{transition:none}}"
    },
    {
      "name": "Theme control",
      "kind": "button",
      "refersTo": "theme-toggle",
      "description": "Outlined sun/moon action; its label names the destination mode and becomes icon-only below 360px.",
      "html": "<button class=\"ds-toggle\" type=\"button\" aria-label=\"Switch to light mode\"><svg aria-hidden=\"true\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5\"/></svg><span>Light mode</span></button>",
      "css": ".ds-toggle{font-family:Manrope,Arial,sans-serif;min-height:44px;padding:8px 15px;font-size:12px;line-height:1.75;white-space:nowrap;background:transparent;color:var(--text,#e7ecf5);border:1px solid var(--line,#2c3850);border-radius:999px;cursor:pointer;transition:background var(--duration,.25s)}.ds-toggle:hover{background:var(--surface,#11192b)}.ds-primary:focus-visible,.ds-link:focus-visible,.ds-toggle:focus-visible,.ds-nav a:focus-visible,.ds-summary:focus-visible,.ds-motion:focus-visible{outline:2px solid var(--accent,#a9befa);outline-offset:5px}@media(max-width:767px){.ds-toggle{font-size:11px;padding-inline:12px}}@media(prefers-reduced-motion:reduce){.ds-toggle{transition:none}}.ds-toggle{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-width:44px}@media(max-width:359px){.ds-toggle span{display:none}}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "navigation-link",
      "description": "Desktop link row, with the expanded phone menu layout shown at phone widths.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a href=\"#about\" aria-current=\"location\">About</a><a href=\"#projects\">Projects</a><a href=\"#experience\">Experience</a><a href=\"#contact\">Contact</a></nav>",
      "css": ".ds-nav{font-family:Manrope,Arial,sans-serif;display:flex;align-items:center;gap:26px}.ds-nav a{display:flex;align-items:center;min-height:44px;font-size:13px;line-height:1.75;color:var(--muted,#a2aec2);position:relative;text-decoration:none}.ds-nav a::after{content:'';position:absolute;bottom:7px;left:0;right:0;height:1px;background:var(--accent,#a9befa);transform:scaleX(0);transform-origin:left;transition:transform var(--duration,.25s) var(--ease,cubic-bezier(.16,1,.3,1))}.ds-nav a:hover,.ds-nav a[aria-current='location']{color:var(--text,#e7ecf5)}.ds-nav a:hover::after,.ds-nav a[aria-current='location']::after{transform:scaleX(1)}.ds-primary:focus-visible,.ds-link:focus-visible,.ds-toggle:focus-visible,.ds-nav a:focus-visible,.ds-summary:focus-visible,.ds-motion:focus-visible{outline:2px solid var(--accent,#a9befa);outline-offset:5px}@media(max-width:767px){.ds-nav{display:grid;grid-template-columns:1fr 1fr;gap:8px 16px;background:var(--paper,#0b1020);border-bottom:1px solid var(--line,#2c3850);padding:16px 20px}.ds-nav a{font-size:15px;padding:10px 8px;min-height:48px}.ds-nav a::after{display:none}}@media(prefers-reduced-motion:reduce){.ds-nav a::after{transition:none}}"
    },
    {
      "name": "Skill chips",
      "kind": "chip",
      "refersTo": "skill-chip",
      "description": "Static, wrapping metadata pills; these are not filter or selection controls.",
      "html": "<ul class=\"ds-chips\" aria-label=\"Technical skills\"><li>Python</li><li>C++</li><li>TCP/IP</li><li>Electronic circuits</li></ul>",
      "css": ".ds-chips{font-family:Manrope,Arial,sans-serif;display:flex;flex-wrap:wrap;gap:8px;list-style:none;padding:0;margin:0}.ds-chips li{background:var(--pill,#192640);color:var(--accent,#a9befa);padding:5px 13px;border-radius:999px;font-size:12px;line-height:1.75}"
    },
    {
      "name": "Projects empty state",
      "kind": "card",
      "refersTo": "empty-projects",
      "description": "The shipped project state is empty; this panel communicates that without invented projects.",
      "html": "<div class=\"ds-empty\"><div><h3>A little more to come.</h3><p>Project stories will be added here soon.</p></div></div>",
      "css": ".ds-empty{font-family:Manrope,Arial,sans-serif;min-height:180px;padding:35px;display:flex;align-items:center;border-radius:16px;background:var(--surface,#11192b);color:var(--text,#e7ecf5)}.ds-empty h3{margin:0;font-size:19px;line-height:1.25;font-weight:600;letter-spacing:-.02em}.ds-empty p{margin:8px 0 0;font-size:14px;line-height:1.75;color:var(--muted,#a2aec2)}@media(max-width:767px){.ds-empty{min-height:155px;padding:26px}.ds-empty h3{font-size:17px}.ds-empty p{font-size:13px}}"
    },
    {
      "name": "Experience disclosure",
      "kind": "custom",
      "refersTo": "experience-disclosure",
      "description": "Native details row with a rotating plus affordance and secondary detail text.",
      "html": "<details class=\"ds-role\"><summary class=\"ds-summary\"><div><p class=\"ds-date\">Sep 2022 - Feb 2023</p><h3>Engineering Intern</h3><p>Singapore Polytechnic</p></div><span class=\"ds-expand\"><svg aria-hidden=\"true\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg></span></summary><div class=\"ds-details\">In-house internship in collaboration with Beckhoff Automation Pte Ltd.</div></details>",
      "css": ".ds-role{font-family:Manrope,Arial,sans-serif;border-bottom:1px solid var(--line,#2c3850);color:var(--text,#e7ecf5)}.ds-summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:24px;padding-block:28px}.ds-summary::-webkit-details-marker{display:none}.ds-summary h3{margin:0;font-size:22px;line-height:1.25;font-weight:600;letter-spacing:-.02em}.ds-summary p{margin:6px 0 0;color:var(--muted,#a2aec2);font-size:14px;line-height:1.75}.ds-summary .ds-date{font-size:12px;margin:0 0 10px;font-variant-numeric:tabular-nums}.ds-expand{display:grid;place-items:center;width:44px;height:44px;flex-shrink:0;border-radius:50%;color:var(--accent,#a9befa);transition:transform var(--duration,.25s) var(--ease,cubic-bezier(.16,1,.3,1)),background var(--duration,.25s)}.ds-role[open] .ds-expand{transform:rotate(45deg)}.ds-summary:hover .ds-expand{background:var(--pill,#192640)}.ds-details{padding-bottom:26px;font-size:14px;line-height:1.75;color:var(--muted,#a2aec2);max-width:480px}.ds-primary:focus-visible,.ds-link:focus-visible,.ds-toggle:focus-visible,.ds-nav a:focus-visible,.ds-summary:focus-visible,.ds-motion:focus-visible{outline:2px solid var(--accent,#a9befa);outline-offset:5px}@media(max-width:767px){.ds-summary{padding-block:24px}.ds-summary h3{font-size:20px}}@media(prefers-reduced-motion:reduce){.ds-expand{transition:none}}"
    },
    {
      "name": "Sky motion control",
      "kind": "button",
      "description": "Visible sky pause affordance; runtime updates its label, pressed state, and disabled reduced-motion state.",
      "html": "<button class=\"ds-motion\" type=\"button\" aria-pressed=\"false\"><svg aria-hidden=\"true\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V6M14 6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1V6\"/></svg><span>Pause motion</span></button>",
      "css": ".ds-motion{font-family:Manrope,Arial,sans-serif;display:inline-flex;align-items:center;gap:8px;min-height:44px;font-size:12px;line-height:1.75;color:var(--muted,#a2aec2);background:transparent;border:0;padding:8px 10px;border-radius:999px;cursor:pointer}.ds-motion svg{color:var(--accent,#a9befa)}.ds-motion:hover{background:var(--surface,#11192b);color:var(--text,#e7ecf5)}.ds-motion:disabled{cursor:default;opacity:.65}.ds-primary:focus-visible,.ds-link:focus-visible,.ds-toggle:focus-visible,.ds-nav a:focus-visible,.ds-summary:focus-visible,.ds-motion:focus-visible{outline:2px solid var(--accent,#a9befa);outline-offset:5px}@media(max-width:767px){.ds-motion{font-size:11px}}"
    },
    {
      "name": "Project story",
      "kind": "content",
      "description": "Open project article; outlined read action uses a horizontal arrow, while repository links remain separate external actions.",
      "html": "<article class=\"ds-project\"><h3>SandScape-AR</h3><p class=\"ds-project-context\">CEG1010 team project</p><p>An augmented reality sandbox that turns depth-camera data into live terrain visuals.</p><ul><li>Python</li><li>OpenCV</li><li>NumPy</li><li>Raspberry Pi</li></ul><div class=\"ds-project-actions\"><button class=\"ds-project-read\" type=\"button\">Read project <svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M12 5l7 7-7 7\"/></svg></button><a href=\"https://github.com/clifz272/SandScape-AR\">GitHub</a></div></article>",
      "css": ".ds-project{font-family:Manrope,Arial,sans-serif;color:var(--text,#e7ecf5);padding-bottom:30px;border-bottom:1px solid var(--line,#2c3850)}.ds-project h3{font-size:23px;font-weight:600;line-height:1.35}.ds-project p{font-size:15px;line-height:1.75;color:var(--muted,#a2aec2)}.ds-project .ds-project-context{font-size:12px}.ds-project ul{display:flex;flex-wrap:wrap;gap:8px;padding:0;list-style:none}.ds-project li{font-size:12px;padding:5px 13px;background:var(--pill,#192640);color:var(--accent,#a9befa);border-radius:999px}.ds-project-actions{display:flex;gap:24px;flex-wrap:wrap}.ds-project-actions a,.ds-project-actions button{min-height:44px;background:none;border:0;font:inherit;font-size:14px;color:var(--accent,#a9befa)}@media(max-width:767px){.ds-project h3{font-size:21px}}.ds-project-actions .ds-project-read{display:inline-flex;align-items:center;gap:16px;min-height:44px;padding:10px 16px;border:1px solid var(--line,#2c3850);border-radius:999px;font-size:13px}.ds-project-read:focus-visible{outline:2px solid var(--accent,#a9befa);outline-offset:5px}.ds-project-read:active{transform:scale(.98)}@media(hover:hover) and (pointer:fine){.ds-project-read:hover{background:var(--pill,#192640)}}"
    }
  ],
  "narrative": {
    "northStar": "Quiet Galaxy",
    "overview": "Midnight surfaces, lunar text, and restrained periwinkle actions carry Clifton's chill, minimal personality. A sparse procedural sky and fine orbital geometry provide atmosphere while the content stays readable and mostly unboxed. The identity uses one type family, generous section spacing, and a small set of clear controls.\n\nThe first visit starts in dark mode. A manual theme control switches to the corresponding light palette and persists the visitor's choice. The shipped landscape photograph has been removed; the sky is native canvas and CSS geometry, with SVG files for interface icons.",
    "keyCharacteristics": [
      "Quiet blue atmosphere with a single action accent.",
      "Self-hosted Manrope across headings, body, and controls.",
      "Flat reading sections, fine dividers, and pill-shaped actions.",
      "Decorative hero motion with pause and reduced-motion support.",
      "Compact phone layouts with large interactive targets."
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "body": "Use the theme's existing blue accent for actions and emphasis; keep ordinary paragraphs in secondary text and headings in primary text.",
        "section": "colors"
      },
      {
        "name": "The Single Family Rule",
        "body": "Carry hierarchy through Manrope's size, weight, tracking, and color; the shipped interface has no separate display or mono face.",
        "section": "typography"
      },
      {
        "name": "The Stationary Reading Rule",
        "body": "About, projects, experience, and contact remain at rest; do not add scroll-triggered section entrances. The shipped correction removed reading-section reveal motion.",
        "section": "layout"
      },
      {
        "name": "The Tonal Depth Rule",
        "body": "Separate content with the existing surface tones and fine lines; reserve the spherical gradient and orbital transparency for the native galaxy decoration.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the matching dark or light token roles together when adding a control or surface.",
      "Do retain self-hosted Manrope, open content sections, and fine dividers.",
      "Do preserve the phone gutter steps and minimum touch heights when adding navigation or actions.",
      "Do keep decorative sky motion pausable and honor reduced-motion preference.",
      "Do use SVG interface icons and native canvas/CSS for the current galaxy atmosphere."
    ],
    "donts": [
      "Don't add scroll-triggered entrances to the stationary reading sections.",
      "Don't restore the removed landscape photograph to this galaxy interface.",
      "Don't invent project cards, imagery, or evidence while the supplied project data is empty.",
      "Don't add shadows or blur as a default treatment to these flat content surfaces."
    ]
  }
}
